# Variables de entorno para PROMETEO Backend

# Puerto del servidor
PORT=3000

## CORS
# Lista de orígenes permitidos separados por coma (también se aceptan patrones regex como /https:\/\/.*\.midominio\.com$/)
# Si no se define, se usará CLIENT_URL como fallback
CORS_ORIGINS=http://localhost:5173

# Si el frontend envía cookies/Authorization con credenciales, activa esto
CORS_CREDENTIALS=false

FRONTEND_URL=http://localhost:5173

# Entorno de desarrollo
NODE_ENV=development

# Base de datos MongoDB
MONGODB_URI=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT Configuration
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Spotify linked account integration
SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPOTIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/v1/account/linked-accounts/spotify/callback

# Discord linked account integration
DISCORD_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/account/linked-accounts/discord/callback

# Google Workspace linked account integration
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/account/linked-accounts/google/callback

# GitHub linked account integration
GITHUB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/account/linked-accounts/github/callback

LINKED_ACCOUNTS_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Configuración de Socket.io
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# Si la app corre detrás de Traefik/Nginx/Proxy
TRUST_PROXY=true

# Configuración de logs
LOG_LEVEL=info

# WhatsApp widget
# Prefijo para aislar sesiones remotas por usuario autenticado
WHATSAPP_SESSION_PREFIX=personal-whatsapp
# Tiempo maximo que un cliente de WhatsApp puede quedar inactivo antes de cerrarse
WHATSAPP_CLIENT_IDLE_TTL_MS=900000
# Frecuencia con la que se limpian clientes inactivos
WHATSAPP_CLIENT_CLEANUP_INTERVAL_MS=60000

# Discord Bot
DISCORD_BOT_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Creator Status - YouTube
CREATOR_YOUTUBE_CHANNEL_ID=UCXXXXXXXXXXXXXXXXXXXXXX
CREATOR_YOUTUBE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Creator Status - Twitch
CREATOR_TWITCH_USER_LOGIN=tu_canal_twitch
TWITCH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWITCH_APP_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Weather widget - OpenWeather
OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email transaccional
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Debe ser un sender/dominio verificado en Brevo.
BREVO_FROM_EMAIL=noreply@prometeo.app
BREVO_FROM_NAME=Prometeo
# URL publica del frontend para construir enlaces de verify/reset.
FRONTEND_URL=http://localhost:5173
