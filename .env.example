# Variables de entorno para PROMETEO Backend

# Puerto del servidor
PORT=3000

## CORS
# Lista de orígenes permitidos separados por coma (también se aceptan patrones regex como /https:\/\/.*\.midominio\.com$/)
# Si no se define, se usará CLIENT_URL como fallback
CORS_ORIGINS=http://localhost:3001

# Si el frontend envía cookies/Authorization con credenciales, activa esto
CORS_CREDENTIALS=false

# URL del cliente frontend (fallback legacy para CORS)
CLIENT_URL=http://localhost:3001

# Entorno de desarrollo
NODE_ENV=development

# Base de datos MongoDB
MONGODB_URI=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT Configuration
JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_EXPIRES_IN=7d

# Configuración de Socket.io
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# Si la app corre detrás de Traefik/Nginx/Proxy
TRUST_PROXY=true

# Configuración de logs
LOG_LEVEL=info